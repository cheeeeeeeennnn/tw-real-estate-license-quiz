{
  "name": "real-estate-broker-exam-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "vite build",
    "build:questions": "node scripts/buildQuestionBank.js && node scripts/validateQuestions.js",
